        <UserObject label="&lt;br&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;ePaper module&lt;/th&gt;&lt;th&gt;STM32 (&lt;a href=&quot;https://files.waveshare.com/upload/7/71/E-Paper_code.zip&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;noopener nofollow&quot; aria-label=&quot;https://files.waveshare.com/upload/7/71/E-Paper_code.zip&quot; data-tooltip-position=&quot;top&quot;&gt;demo&lt;/a&gt;)&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;VCC&lt;/td&gt;&lt;td&gt;3.3V&lt;/td&gt;&lt;td&gt;3.3V/5V&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;GND&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DIN&lt;/td&gt;&lt;td&gt;PA7&lt;/td&gt;&lt;td&gt;SPI MOSI pin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CLK&lt;/td&gt;&lt;td&gt;PA5&lt;/td&gt;&lt;td&gt;SPI SCK pin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CS&lt;/td&gt;&lt;td&gt;PA4&lt;/td&gt;&lt;td&gt;SPI chip selection, low active&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DC&lt;/td&gt;&lt;td&gt;PA2&lt;/td&gt;&lt;td&gt;Data/Command selection (high for data, low for command)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RST&lt;/td&gt;&lt;td&gt;PA1&lt;/td&gt;&lt;td&gt;External reset, low active&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BUSY&lt;/td&gt;&lt;td&gt;PA3&lt;/td&gt;&lt;td&gt;Busy status output, high active&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" link="&lt;table&gt;&#xa;&lt;thead&gt;&#xa;&lt;tr&gt;&#xa;&lt;th&gt;ePaper module&lt;/th&gt;&#xa;&lt;th&gt;STM32 (&lt;a href=&quot;https://files.waveshare.com/upload/7/71/E-Paper_code.zip&quot; class=&quot;external-link&quot; target=&quot;_blank&quot; rel=&quot;noopener nofollow&quot; aria-label=&quot;https://files.waveshare.com/upload/7/71/E-Paper_code.zip&quot; data-tooltip-position=&quot;top&quot;&gt;demo&lt;/a&gt;)&lt;/th&gt;&#xa;&lt;th&gt;&lt;/th&gt;&#xa;&lt;/tr&gt;&#xa;&lt;/thead&gt;&#xa;&lt;tbody&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;VCC&lt;/td&gt;&#xa;&lt;td&gt;3.3V&lt;/td&gt;&#xa;&lt;td&gt;3.3V/5V&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;GND&lt;/td&gt;&#xa;&lt;td&gt;GND&lt;/td&gt;&#xa;&lt;td&gt;&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;DIN&lt;/td&gt;&#xa;&lt;td&gt;PA7&lt;/td&gt;&#xa;&lt;td&gt;SPI MOSI pin&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;CLK&lt;/td&gt;&#xa;&lt;td&gt;PA5&lt;/td&gt;&#xa;&lt;td&gt;SPI SCK pin&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;CS&lt;/td&gt;&#xa;&lt;td&gt;PA4&lt;/td&gt;&#xa;&lt;td&gt;SPI chip selection, low active&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;DC&lt;/td&gt;&#xa;&lt;td&gt;PA2&lt;/td&gt;&#xa;&lt;td&gt;Data/Command selection (high for data, low for command)&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;RST&lt;/td&gt;&#xa;&lt;td&gt;PA1&lt;/td&gt;&#xa;&lt;td&gt;External reset, low active&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;tr&gt;&#xa;&lt;td&gt;BUSY&lt;/td&gt;&#xa;&lt;td&gt;PA3&lt;/td&gt;&#xa;&lt;td&gt;Busy status output, high active&lt;/td&gt;&#xa;&lt;/tr&gt;&#xa;&lt;/tbody&gt;&#xa;&lt;/table&gt;" id="UzmNd9kbbkJofZ3QINB8-1">
